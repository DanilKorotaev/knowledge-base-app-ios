# frozen_string_literal: true

require "json"
require "shellwords"

opt_out_usage

default_platform(:ios)

platform :ios do
  desc "Run unit tests (KnowledgeBaseApp) with coverage; fails if line coverage < MIN_COVERAGE (default 35)."
  lane :test do
    setup_ci if ENV["CI"]

    run_xcodegen!

    device = ENV.fetch("SCAN_DEVICE", "iPhone 15")
    output_dir = File.expand_path("test_output", __dir__)

    scan(
      scheme: "KnowledgeBaseApp",
      device: device,
      clean: true,
      code_coverage: true,
      result_bundle: true,
      output_directory: output_dir,
      buildlog_path: File.expand_path("build_logs", __dir__)
    )

    enforce_line_coverage_threshold(output_dir)
  end

  desc "Build App Store IPA and upload to TestFlight. Requires Match repo, ASC API key, and real bundle ID + team."
  lane :beta do
    setup_ci if ENV["CI"]

    run_xcodegen!

    app_id = ENV["APP_IDENTIFIER"].to_s.strip
    app_id = "com.coredan.KnowledgeBaseApp" if app_id.empty?

    widget_id = ENV["WIDGET_APP_IDENTIFIER"].to_s.strip
    widget_id = "com.coredan.KnowledgeBaseApp.Widget" if widget_id.empty?

    watch_id = ENV["WATCH_APP_IDENTIFIER"].to_s.strip
    watch_id = "com.coredan.KnowledgeBaseApp.watch" if watch_id.empty?

    watch_widget_id = ENV["WATCH_WIDGET_APP_IDENTIFIER"].to_s.strip
    watch_widget_id = "com.coredan.KnowledgeBaseApp.watch.widget" if watch_widget_id.empty?

    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_CONTENT"),
      is_key_content_base64: false
    )

    match_params = {
      type: "appstore",
      readonly: is_ci,
      app_identifier: [app_id, widget_id, watch_id, watch_widget_id]
    }
    if ENV["MATCH_GIT_URL"] && !ENV["MATCH_GIT_URL"].empty?
      match_params[:git_url] = ENV["MATCH_GIT_URL"]
    end
    if ENV["MATCH_GIT_BASIC_AUTHORIZATION"] && !ENV["MATCH_GIT_BASIC_AUTHORIZATION"].empty?
      match_params[:git_basic_authorization] = ENV["MATCH_GIT_BASIC_AUTHORIZATION"]
    end
    match(**match_params)

    marketing = read_marketing_version!
    # Fastlane cwd is often `fastlane/`; resolve scripts from repo root via Fastfile dir.
    sync_script = File.expand_path("../scripts/ci/sync_marketing_version.sh", __dir__)
    UI.user_error!("Missing #{sync_script}") unless File.file?(sync_script)
    sh("bash", sync_script)
    increment_version_number(
      xcodeproj: "KnowledgeBaseApp.xcodeproj",
      version_number: marketing
    )

    increment_build_number(
      xcodeproj: "KnowledgeBaseApp.xcodeproj",
      build_number: ENV["GITHUB_RUN_NUMBER"]
    ) if ENV["CI"] && ENV["GITHUB_RUN_NUMBER"]

    team_id = ENV["TEAM_ID"].to_s.strip
    team_id = "66C9VGAZR5" if team_id.empty?

    # CI has no Xcode account session: Automatic signing resolves to "Development" profiles and archive fails.
    # Match already installed App Store profiles; pin Manual + Distribution for Release only (local stays Automatic/Debug).
    if is_ci
      mapping = lane_context[:MATCH_PROVISIONING_PROFILE_MAPPING] || {}
      main_prof = mapping[app_id]
      widget_prof = mapping[widget_id]
      watch_prof = mapping[watch_id]
      watch_widget_prof = mapping[watch_widget_id]
      UI.user_error!("Match did not set provisioning profile mapping for app targets") unless main_prof && widget_prof && watch_prof && watch_widget_prof

      update_code_signing_settings(
        path: "KnowledgeBaseApp.xcodeproj",
        use_automatic_signing: false,
        targets: ["KnowledgeBaseApp"],
        build_configurations: ["Release"],
        team_id: team_id,
        code_sign_identity: "Apple Distribution",
        profile_name: main_prof
      )
      update_code_signing_settings(
        path: "KnowledgeBaseApp.xcodeproj",
        use_automatic_signing: false,
        targets: ["KnowledgeBaseWidgetExtension"],
        build_configurations: ["Release"],
        team_id: team_id,
        code_sign_identity: "Apple Distribution",
        profile_name: widget_prof
      )
      update_code_signing_settings(
        path: "KnowledgeBaseApp.xcodeproj",
        use_automatic_signing: false,
        targets: ["KnowledgeBaseWatchApp"],
        build_configurations: ["Release"],
        team_id: team_id,
        code_sign_identity: "Apple Distribution",
        profile_name: watch_prof
      )
      update_code_signing_settings(
        path: "KnowledgeBaseApp.xcodeproj",
        use_automatic_signing: false,
        targets: ["KnowledgeBaseWatchWidgetExtension"],
        build_configurations: ["Release"],
        team_id: team_id,
        code_sign_identity: "Apple Distribution",
        profile_name: watch_widget_prof
      )
    end

    build_app(
      scheme: "KnowledgeBaseApp",
      export_method: "app-store",
      export_options: {
        teamID: team_id
      }
    )

    asc_app_id = ENV["ASC_APPLE_ID"].to_s.strip
    asc_app_id = "6768027088" if asc_app_id.empty?
    configure_deliver_altool_for_xcode26!(platform: "ios", apple_id: asc_app_id)

    upload_to_testflight(
      app_identifier: app_id,
      apple_id: asc_app_id,
      app_platform: "ios",
      skip_waiting_for_build_processing: true
    )

    write_ci_testflight_metadata(
      app_identifier: app_id,
      xcodeproj: "KnowledgeBaseApp.xcodeproj",
      target: "KnowledgeBaseApp"
    )
  end
end

# Xcode 26+ new altool breaks fastlane's `--upload-app -f` + `-t ios` combo.
# Legacy altool accepts the same flags; --platform alone does not fix --upload-app.
# https://github.com/fastlane/fastlane/issues/29743
def configure_deliver_altool_for_xcode26!(platform:, apple_id:)
  existing = ENV["DELIVER_ALTOOL_ADDITIONAL_UPLOAD_PARAMETERS"].to_s.strip
  additions = []
  additions << "--use-old-altool" unless existing.include?("--use-old-altool")
  additions << "--apple-id #{apple_id}" unless apple_id.to_s.empty? || existing.include?("--apple-id")
  # Legacy altool uses fastlane's `-t ios`; `--platform` is for new altool only and confuses old altool.
  unless existing.include?("--platform") || additions.include?("--use-old-altool") || existing.include?("--use-old-altool")
    additions << "--platform #{platform}"
  end
  ENV["DELIVER_ALTOOL_ADDITIONAL_UPLOAD_PARAMETERS"] = [existing, *additions].reject(&:empty?).join(" ")
  UI.message("DELIVER_ALTOOL_ADDITIONAL_UPLOAD_PARAMETERS=#{ENV['DELIVER_ALTOOL_ADDITIONAL_UPLOAD_PARAMETERS']}")
end

def write_ci_testflight_metadata(app_identifier:, xcodeproj:, target:)
  output_dir = File.expand_path("test_output", __dir__)
  FileUtils.mkdir_p(output_dir)
  payload = {
    "marketing_version" => get_version_number(xcodeproj: xcodeproj, target: target),
    "build_number" => get_build_number(xcodeproj: xcodeproj),
    "app_identifier" => app_identifier
  }
  File.write(File.join(output_dir, "ci_testflight.json"), JSON.pretty_generate(payload))
  UI.success("Wrote #{output_dir}/ci_testflight.json")
end

def run_xcodegen!
  script = File.expand_path("../scripts/ci/xcodegen_generate.sh", __dir__)
  UI.user_error!("Missing #{script}") unless File.file?(script)
  sh("bash", script)
end

def read_marketing_version!
  path = File.expand_path("../VERSION", __dir__)
  UI.user_error!("VERSION file missing at #{path}") unless File.file?(path)
  version = File.read(path).strip
  UI.user_error!("VERSION is empty") if version.empty?
  unless version.match?(/\A\d+\.\d+\.\d+([.-][0-9A-Za-z.-]+)?\z/)
    UI.user_error!("VERSION must be SemVer MAJOR.MINOR.PATCH, got: #{version.inspect}")
  end
  UI.message("Marketing version from VERSION: #{version}")
  version
end

def enforce_line_coverage_threshold(output_dir)
  xcresult = Dir.glob(File.join(output_dir, "*.xcresult")).first
  UI.user_error!("No .xcresult in #{output_dir}; scan may have failed silently") unless xcresult

  min = ENV.fetch("MIN_COVERAGE", "35").to_f
  json = `xcrun xccov view --report --json #{Shellwords.escape(xcresult)}`
  unless $?.success?
    UI.user_error!("xccov failed: #{json}")
  end

  data = JSON.parse(json)
  app_target = data.fetch("targets", []).find { |t| t["name"] == "KnowledgeBaseApp.app" }
  UI.user_error!("KnowledgeBaseApp.app not found in coverage report") unless app_target

  coverage = (app_target["lineCoverage"].to_f * 100).round(4)
  UI.success("Line coverage (KnowledgeBaseApp.app): #{coverage}% (minimum #{min}%)")

  UI.user_error!("Coverage #{coverage}% is below minimum #{min}%") if coverage < min
end
