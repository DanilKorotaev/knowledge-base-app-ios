// Copy to Secrets.xcconfig (gitignored). Used for local Run, Archive, and TestFlight builds.
// Do not commit real URLs or tokens. See docs/API_CONFIGURATION.md.

SLASH = /
KBAPP_API_BASE_URL = https:$(SLASH)$(SLASH)api.example.com
KBAPP_AUTH_TOKEN = your-bearer-token

INFOPLIST_KEY_KBAppAPIBaseURL = $(KBAPP_API_BASE_URL)
INFOPLIST_KEY_KBAppAuthToken = $(KBAPP_AUTH_TOKEN)
