// Optional local template. The app does not read baked URL/token from Info.plist —
// set the server in onboarding / Settings; JWT is stored in Keychain after login.
// Keep this file empty (or omit Secrets.xcconfig) for normal runs.
//
// E2E / scheme overrides still use env vars KB_E2E_* or KBAPP_* — see docs/API_CONFIGURATION.md.

SLASH = /
KBAPP_API_BASE_URL =
KBAPP_AUTH_TOKEN =

INFOPLIST_KEY_KBAppAPIBaseURL = $(KBAPP_API_BASE_URL)
INFOPLIST_KEY_KBAppAuthToken = $(KBAPP_AUTH_TOKEN)
